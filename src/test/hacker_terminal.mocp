/* ==========================================================
 * TERMINAL HACKER MOCP v1.0
 * ==========================================================
 * Este programa testa todas as funcionalidades do compilador:
 * - Tree-Shaking (Injeção de Helpers e Scanner)
 * - Retorno na principal (System.exit)
 * - Múltiplos I/O (ler, lerc, lers, escrever, escreverc, etc)
 * - Casts, Unários, Ciclos e Condições
 * ========================================================== */

// --- PROTÓTIPOS ---
vazio cabecalho(vazio);
vazio cifrar(inteiro[], inteiro);
inteiro principal(vazio);

// --- VARIÁVEIS GLOBAIS ---
inteiro chave_secreta = 3;
real versao = 2.5;

// --- FUNÇÕES ---

vazio cabecalho(vazio) {
    escrevers("\n====================================\n");
    escrevers("       TERMINAL HACKER MOCP v");

    // Cast de real para inteiro só para provar que o compilador sabe fazer!
    escrever((inteiro)versao);

    escrevers(".0\n");
    escrevers("====================================\n");
}

/* Função para encriptar uma palavra (Cifra de César simples) */
vazio cifrar(inteiro msg[], inteiro offset) {
    inteiro i = 0;
    enquanto (msg[i] != 0) {
        msg[i] = msg[i] + offset;
        i = i + 1;
    }
}

// --- FUNÇÃO PRINCIPAL ---
inteiro principal(vazio) {
    inteiro nome[];
    inteiro carac;
    inteiro vetor_codigos[5];
    inteiro i, semente;

    cabecalho();

    escrevers("Introduz o teu nome de agente (1 palavra): ");
    nome = lers(); // [!] ATIVA: usaScanner e usaHelperLerString

    escrevers("\nBem-vindo, agente ");
    escrevers(nome); // [!] ATIVA: usaHelperImprimirString
    escrevers("!\n");

    escrevers("Queres hackear a firewall da universidade? (S/N): ");
    carac = lerc(); // [!] ATIVA: usaScanner

    se (carac == 'S' || carac == 's') {
        escrevers("\n[!] Acesso Autorizado [!]\n");

        escrevers("Introduz uma semente (numero inteiro) para gerar a chave: ");
        semente = ler(); // [!] ATIVA: usaScanner

        // Preenche o vetor com alguma matemática divertida
        para (i = 0; i < 5; i = i + 1) {
            vetor_codigos[i] = (semente * (i + 1)) - (i * 2);
        }

        escrevers("Gerando sequencia de acesso remoto: ");
        escreverv(vetor_codigos); // [!] ATIVA: usaHelperImprimirVetor
        escrevers("\n");

        escrevers("Introduz uma palavra-passe secreta para ocultar: ");
        inteiro password[];
        password = lers();

        // Passamos o vetor por referência (o C/MOCP e o Java funcionam igual aqui)
        cifrar(password, chave_secreta);

        escrevers("A transmitir pacote encriptado: ");
        escrevers(password);
        escrevers("\n");

        escrevers("A apagar os rastos...\n");

    } senao {
        // Se a pessoa meter um caractere diferente
        escrevers("\n[!] Missao Abortada. Es um cobarde, agente ");
        escrevers(nome);
        escrevers(".\n");
    }

    // Para mostrar um caracter individual e testar o escreverc()
    escrevers("\nStatus final de ligacao: ");
    escreverc('X');
    escrevers("\n");

    // [!] ATIVA: O nosso mapeamento brutal para System.exit(0)
    retornar 0;
}